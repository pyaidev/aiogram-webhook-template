# Generate .env with: make init
ENVIRONMENT=development
BOT_TOKEN=
WEBHOOK_SECRET=development-only-change-before-deploy
# Full HTTPS URL, including exactly WEBHOOK_PATH. Register explicitly after TLS is ready.
WEBHOOK_URL=
WEBHOOK_PATH=/telegram/webhook
DATABASE_URL=postgresql+asyncpg://bot:bot@postgres:5432/bot
POSTGRES_DB=bot
POSTGRES_USER=bot
POSTGRES_PASSWORD=bot
REDIS_PASSWORD=development-redis-change-me
REDIS_URL=redis://:development-redis-change-me@redis:6379/0
METRICS_TOKEN=
GRAFANA_ADMIN_USER=admin
GRAFANA_ADMIN_PASSWORD=change-me
ADMIN_IDS=[]
LOG_LEVEL=INFO
USER_RATE_LIMIT=10
USER_RATE_WINDOW=10
INGRESS_RATE_LIMIT=2000
INGRESS_RATE_WINDOW=1
WORKER_MAX_ATTEMPTS=5
WORKER_TIMEOUT_SECONDS=30
SENTRY_DSN=
RELEASE=development
